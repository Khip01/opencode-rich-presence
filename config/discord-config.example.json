{
    "_help_app_id": "Get from https://discord.com/developers/applications",
    "_help_asset": "Upload image at Rich Presence > Art Assets, use filename (no ext) as key",
    "_help_currency": "Currency symbol for cost display (default $). Change to €, £, ¥, Rp, etc.",
    "_help_templates": "Template syntax: {var} for substitution, {{#if var == \"x\"}}...{{/if}} for conditionals. See docs/CUSTOMIZATION.md",
    "_help_modelVars": "Model variables: {model} (full), {modelCode} (code), {modelName} (Title Case), {modelNameLower} (lowercase), {effort} (canonical lowercase), {effortLower} (lowercase), {effortUpper} (UPPERCASE), {effortCapital} (Capitalized); effort is empty when unavailable",
    "_help_compact": "Use {varCompact} (e.g. {contextCompact}, {costCompact}, {promptsCompact}) for large numbers (500K, 1.5M, etc.)",

    "discordAppId": "1512803991300476989",
    "discordLargeImageKey": "opencode-logo-too-rich-presence",
    "currency": "$",
    "_help_replacements": "Wildcard text replacements applied to template vars before rendering. Wildcard * only at start and/or end of from (e.g. plan, *Free, Free*, *Free*). Case-sensitive, literal match.",
    "replacements": [
        { "vars": ["model", "modelName", "modelCode", "modelNameLower"], "from": "* Free", "to": "" },
        { "vars": ["mode"], "from": "plan", "to": "Planning" },
        { "vars": ["mode"], "from": "build", "to": "Building" }
    ],

    "presence": {
        "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
        "state": "{state} • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts",
        "largeImageText": "Context: {context} / {contextLimit} tokens",
        "smallImageText": "Provider: {provider}",

        "byState": {
            "Waiting for command": {
                "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
                "state": "Completed! • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts"
            },
            "Working": {
                "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
                "state": "Working • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts"
            },
            "Thinking": {
                "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
                "state": "Thinking • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts"
            },
            "Typing": {
                "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
                "state": "Typing • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts"
            },
            "Asking": {
                "details": "{modelName}{{#if effort}} · {effortCapital} effort{{/if}} ({mode}) {{#if cost == \"free\"}} • $0 spent{{else}}{costCompact} spent{{/if}}",
                "state": "Asking • {contextCompact}/{contextLimitCompact} tok • {promptsCompact} prmpts"
            }
        },

        "idle": {
            "details": "{modelName|OpenCode}{{#if effort}} · {effortCapital} effort{{/if}} ({mode|standby}) • $0 spent",
            "state": "Waiting • {contextCompact|0}/{contextLimitCompact|0} tok • {promptsCompact|0} prmpts",
            "largeImageText": "Context: {context|0} / {contextLimit|0} tokens",
            "smallImageText": "Provider: {provider|Local}"
        },

        "home": {
            "details": "OpenCode",
            "state": "Ready",
            "largeImageText": "OpenCode",
            "smallImageText": "Waiting..."
        }
    }
}
