*~

# OS
.DS_Store
Thumbs.db

# Build artifacts (none expected: pure JS, no build step)

# Sensitive / personal
.env
.env.local

# Install-channel marker (runtime artifact written by update.js, never
# committed — this is a safety net in case the marker is ever written
# into the repo working directory by mistake).
.install-channel

# Presence control state (written by on/off/kill/spawn at runtime). Lives in
# ~/.config/opencode, but ignore it here too in case a stray write lands in
# the repo working directory.
*.state.json

# Per-instance presence state snapshots (presence-states/ subdir since 3.4,
# flat presence-state-pid<N>.txt before that). Same safety-net rationale:
# these belong in ~/.config/opencode, never in source control.
presence-states/
presence-state-pid*.txt
